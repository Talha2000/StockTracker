# Copy to .env (gitignored). Read by API/index.js; never expose to the client.
FINNHUB_KEY=
TWELVEDATA_KEY=

# Neon Postgres, used via Prisma (API/prisma/schema.prisma).
# DATABASE_URL: the pooled connection string (for the app at runtime).
# DATABASE_URL_UNPOOLED: the direct (non -pooler) connection string
#   (Prisma Migrate needs this — the pooler doesn't support advisory locks).
# Get both from the Neon console (or `neon env pull`): a pooled host looks
# like ...-pooler.<region>.aws.neon.tech, the direct one omits "-pooler".
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Must match the API's existing secret or logged-in users will be signed out.
ACCESS_TOKEN=
