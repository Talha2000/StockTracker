generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // No directUrl for now (see CLAUDE.md): Prisma Migrate then runs over the
  // pooled connection too, which doesn't support the advisory locks it
  // normally takes — fine as long as migrations are applied by running
  // `npm run db:migrate`/`db:deploy` locally against DATABASE_URL_UNPOOLED
  // (still in the local .env), not from Vercel's build. Add directUrl back
  // (and DATABASE_URL_UNPOOLED on Vercel) if that ever breaks.
}

model User {
  id        String     @id @default(cuid())
  username  String     @unique
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  watchlist Watchlist[]
}

// One row per (user, symbol) a user has bookmarked. Replaces the old Mongo
// UserStock collection, which stored the user id as a loose string with no
// real foreign key; this enforces it and cascades deletes.
model Watchlist {
  id          String   @id @default(cuid())
  userId      String
  stockSymbol String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stockSymbol])
  @@index([userId])
}
